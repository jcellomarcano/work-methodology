{
  "_comment": "The kit's hook entries for <repo>/.claude/settings.local.json. Merged in by lib/settings_merge.py, which substitutes __TOOLS_DEFAULT__ and recognizes its own entries by the ': metodo-hook;' marker. output_author runs on output_write and on Edit|Write|MultiEdit (a round output written by hand is attributed too, T18). validate_subagent_output does not go here: it travels in each schema-bearing role's frontmatter. done_gate runs on Stop and on every SubagentStop and filters the writer roles itself (no documented agent-type matcher is cited in the kit); its timeout is 30 s because it runs docs_lint, kit-status --check and cite_check.",
  "hooks": {
    "PreToolUse": [
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/guard_paths.py\" ] || exit 0; exec python3 \"$H/guard_paths.py\""}]},
      {"matcher": "Bash|mcp__metodo__receipt_start|mcp__metodo__receipt_finalize|mcp__metodo__receipt_acknowledge", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/guard_gates.py\" ] || exit 0; exec python3 \"$H/guard_gates.py\""}]},
      {"matcher": "", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/budget.py\" ] || exit 0; exec python3 \"$H/budget.py\""}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/guard_gates.py\" ] || exit 0; exec python3 \"$H/guard_gates.py\""}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/tool_output_filter.py\" ] || exit 0; exec python3 \"$H/tool_output_filter.py\""}]},
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/touched_paths.py\" ] || exit 0; exec python3 \"$H/touched_paths.py\""}]},
      {"matcher": "mcp__metodo__output_write", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/output_author.py\" ] || exit 0; exec python3 \"$H/output_author.py\""}]}
,
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/output_author.py\" ] || exit 0; exec python3 \"$H/output_author.py\""}]}
    ],
    "Stop": [
      {"matcher": "", "hooks": [{"type": "command", "timeout": 30,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/done_gate.py\" ] || exit 0; exec python3 \"$H/done_gate.py\""}]}
    ],
    "SubagentStop": [
      {"matcher": "", "hooks": [{"type": "command", "timeout": 30,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/done_gate.py\" ] || exit 0; exec python3 \"$H/done_gate.py\""}]}
    ],
    "SessionStart": [
      {"matcher": "startup|resume|compact|clear", "hooks": [{"type": "command", "timeout": 10,
        "command": ": metodo-hook; H=\"${METODO_TOOLS:-__TOOLS_DEFAULT__}/hooks\"; [ -f \"$H/session_start_status.py\" ] || exit 0; exec python3 \"$H/session_start_status.py\""}]}
    ]
  }
}
