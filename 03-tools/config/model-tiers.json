    "gemini-cli": {
      "agent_dir": ".gemini/agents",
      "format": "md+yaml",
      "fields": [
        "name",
        "description",
        "model",
        "tools",
        "mcpServers",
        "max_turns",
        "timeout_mins",
        "temperature"
      ],
      "budget": "max_turns+timeout_mins [Asumido]",
      "output_validation": "orquestador via lib/round_output.py",
      "installer": "pending: install-gemini.sh",
      "headless": "gemini -p <prompt> -m <id> --skip-trust (or GEMINI_CLI_TRUST_WORKSPACE=true); measured 15-sep-2026 with Gemini Code Assist for individuals OAuth"
    },
    "codex-cli": {
      "agent_dir": ".codex/agents",
      "format": "toml",
      "fields": [
        "name",
        "description",
        "developer_instructions",
        "model",
        "reasoning",
        "sandbox",
        "mcp_servers"
