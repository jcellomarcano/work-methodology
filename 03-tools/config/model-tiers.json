  "admission": {
    "min_runs": 2,
    "same_brief_required": true,
    "gates": [
      "round_output PASS",
      "cite_check >= incumbent",
      "judge CONFIRMED rate >= incumbent",
      "tokens and cost in runs/"
    ],
    "critical_lane_requires_owner_ok": true,
    "record": "minutes/ + status in this file"
