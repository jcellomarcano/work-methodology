{
  "_comment": "Done gate (context-method §6, odd/research/context/done-gate.md §3). Read by lib/done_check.py. Every rule starts in mode FLAG (D2: visible warn first); target_mode is the mode done-gate.md names, reached per rule only at >= 20 fires and a false-positive share <= 10% (done-gate.md §5). mode PASS turns a rule off (reported as SKIP with its findings). Changing this file needs a change card.",
  "schema_version": 1,
  "claims": {
    "done": ["\\b(?:done|finished|complete|completed|fixed)\\b", "\\b(?:listo|lista|listos|listas|terminad[oa]s?|hech[oa]s?|completad[oa]s?|arreglad[oa]s?)\\b"],
    "green": ["\\bgreen\\b", "\\b(?:all )?tests? (?:pass|passes|passed)\\b", "\\bsuite passe[sd]\\b", "\\ben verde\\b", "\\bverdes?\\b", "\\bpasan (?:todos )?los tests\\b"],
    "committed": ["\\bcommitted\\b", "\\bcommitead[oa]s?\\b", "\\bcomitead[oa]s?\\b"],
    "delivered": ["\\bpushed\\b", "\\bdelivered\\b", "\\bpublished\\b", "\\bpublicad[oa]s?\\b", "\\bentregad[oa]s?\\b", "\\bpushead[oa]s?\\b", "\\bready to (?:push|merge)\\b", "\\bPR (?:is )?ready\\b", "\\bPR (?:está )?lista\\b"]
  },
  "status_completed": "(?im)^\\s*status:\\s*completed\\b",
  "json_status_done": ["completed", "done"],
  "json_claim_skip_keys": ["status", "files_changed", "handoff_to", "change_card_id", "fix_id", "variant", "spec", "forbidden_hits", "outside_allowlist"],
  "negation_before": "(?i)(?:^|\\W)(?:not|no|never|nothing|isn't|aren't|wasn't|weren't|nor|sin|nada|ni|todavía no|aún no|yet to be)\\s+(?:\\S+\\s+){0,2}$",
  "claim_exclusions": ["(?i)\\b(?:de|el|un|del) hecho\\b", "(?i)\\bhecho de que\\b", "(?i)\\bDONE-GATE\\b", "(?i)\\bDONE-\\d+\\b", "(?i)\\bdone[_-]check\\b", "(?i)\\bdone[_-]gate\\b"],
  "feature_claim": ["(?i)\\bfeature (?:is )?(?:done|complete|completed|finished)\\b", "(?i)\\ball tasks (?:are )?(?:done|complete|completed)\\b", "(?i)\\b(?:la )?feature (?:está )?(?:lista|terminada|completada|hecha)\\b", "(?i)\\btodas las tareas (?:están )?(?:listas|hechas|terminadas)\\b"],
  "rules": {
    "DONE-01": {"title": "claim detection", "mode": "FLAG", "target_mode": "FLAG", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-02": {"title": "green run for touched code", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-03": {"title": "RED before GREEN", "mode": "FLAG", "target_mode": "FLAG", "strict_tdd_mode": "FLAG", "strict_tdd_target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-04": {"title": "no weakened test", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-05": {"title": "docs caps", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-06": {"title": "README status block", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-07": {"title": "receipt", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["delivered"]},
    "DONE-08": {"title": "every spec judged", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "delivered"]},
    "DONE-09": {"title": "card verification ran", "mode": "FLAG", "target_mode": "FLAG", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-10": {"title": "Not tested present", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-11": {"title": "no unticketed action tag", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-12": {"title": "no comment-gate marker", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-13": {"title": "committed means committed", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["committed", "delivered"]},
    "DONE-14": {"title": "citations exist", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-15": {"title": "tags have evidence", "mode": "FLAG", "target_mode": "FLAG", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-16": {"title": "subagent status matches validation", "mode": "FLAG", "target_mode": "BLOCK", "claims": ["done", "green", "committed", "delivered"]},
    "DONE-17": {"title": "nothing left running or lying around", "mode": "FLAG", "target_mode": "FLAG", "claims": ["done", "green", "committed", "delivered"]}
  },
  "exempt_tier_skips": ["DONE-02", "DONE-03", "DONE-04", "DONE-09"],
  "exempt_globs": ["*.md", "**/*.md", "*.txt", "**/*.txt", "LICENSE*", ".gitignore", "**/.gitignore"],
  "test_globs": ["tests/**", "**/tests/**", "test/**", "**/test/**", "**/src/test/**", "**/src/androidTest/**", "test_*.py", "**/test_*.py", "**/*_test.py", "**/*_test.go", "**/*Test.kt", "**/*Test.java", "**/*.test.ts", "**/*.test.js", "**/*.spec.ts", "**/*.spec.js"],
  "vendored_globs": ["**/vendor/**", "vendor/**", "**/generated/**", "**/fixtures/**"],
  "sectors": [
    {"name": "03-tools", "globs": ["03-tools/**"]},
    {"name": "08-benchmark", "globs": ["08-benchmark/**"]}
  ],
  "sector_fallback": "top-level directory, '.' for root files",
  "run_binding": "A run proves only the repo it ran in: its `repo` (bin/run-check.sh records the repo root) must equal the checked repo; a run without `repo` is ignored. DONE-02 trusts the run name: a run named after the sector proves it; argv is recorded for the reader and never compared with a sector command (known limit, no command matcher). DONE-03's red run must share the green run's head_sha and come before it.",
  "weakened_test": {
    "test_function": "^\\s*(?:async\\s+)?def\\s+test\\w*\\s*\\(|@Test\\b|^\\s*fun\\s+`|^\\s*(?:it|test)\\s*\\(|^\\s*func\\s+Test\\w*\\(",
    "assertion": "\\bassert\\w*\\b|\\bexpect\\s*\\(|\\bverify\\s*\\(|\\bshould\\w*\\b",
    "skip_marker": "@unittest\\.skip\\w*|@pytest\\.mark\\.(?:skip\\w*|xfail)|\\bskipTest\\s*\\(|@Ignore\\b|@Disabled\\b|\\b(?:it|test|describe)\\.skip\\s*\\(|\\bxit\\s*\\(|\\bt\\.Skip\\w*\\("
  },
  "action_tag": "(?:^|\\s)(?:#|//|/\\*|\\*|<!--|--|;)\\s*(?:TODO|FIXME|STOPSHIP|XXX)\\b",
  "action_tag_ticketed": "\\bTODO\\([A-Z][A-Z0-9]*-\\d+\\):",
  "comment_marker": "NEEDS[-]COMMENT",
  "not_tested_markers": ["not tested:", "what was not tested", "not measured:", "no probado:", "no se probó", "lo que no se probó", "no medido:"],
  "evidence_tags": "\\[(?:Measured|Tested|Medido|Probado)\\b[^\\]]*\\]",
  "card_how_labels": ["How we'll know", "Cómo lo sabremos"],
  "spec_verdict": "(?im)^\\W*(S\\d+)\\b[^\\n]{0,60}?\\bverdict\\W{0,3}\\s*[:=]\\s*\\**(PASS|FAIL|PARTIAL|NOT_COVERED)\\b",
  "commit_line": "(?i)\\b(?:commit|commits|committed|commiteado|commiteada|sha)\\b",
  "validation_pass": "(?i)\\bexit(?: code)?\\s*[:=]?\\s*0\\b|\\bOK\\b|\\bpass(?:ed|es)?\\b|\\bgreen\\b|\\b0 failed\\b",
  "validation_fail": "(?i)\\bFAIL(?:ED|S|URES?)?\\b|\\berrors?\\s*=\\s*[1-9]|\\bfailures?\\s*=\\s*[1-9]|\\bexit(?: code)?\\s*[:=]?\\s*[1-9]|\\bTraceback\\b|\\bnot ok\\b|\\btimed? ?out\\b",
  "temp_globs": ["*.tmp", "**/*.tmp", "*.orig", "**/*.orig", "*.rej", "**/*.rej", "tmp/**", "**/tmp/**"],
  "kit_markers": ["01-roles", "03-tools/lib/kit_status.py"],
  "docs_caps": "03-tools/config/docs-caps.json",
  "token_caps": "03-tools/config/token-caps.json",
  "timeouts_s": {"docs_lint": 60, "kit_status": 120, "cite_check": 60},
  "hook_time_budget_s": 25,
  "_hook_time_budget_s": "Total seconds hooks/done_gate.py gives done_check, counted from the hook's start; it must stay below the done_gate timeout in hooks/hooks.settings.json (30 s). Every subprocess timeout is cut to what is left; a rule that runs out is a FLAG 'timed out', never silence.",
  "evidence_max_chars": 160,
  "flag_block_max_lines": 40
}
